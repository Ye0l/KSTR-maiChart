  "slideValidation": {
    "notation": "d = (end - start + 8) % 8; start, end, middle are 1..8",
    "rules": {
      "-": "d in {2,3,4,5,6}",
      "^": "d in {1,2,3,5,6,7}; d=4 is forbidden",
      "v": "d in {1,2,3,5,6,7}; d=4 is forbidden",
      "<": "all start/end button pairs including same-number pair according to source table",
      ">": "all start/end button pairs including same-number pair according to source table",
      "p": "all start/end button pairs including same-number pair according to source table",
      "q": "all start/end button pairs including same-number pair according to source table",
      "pp": "all start/end button pairs including same-number pair according to source table",
      "qq": "all start/end button pairs including same-number pair according to source table",
      "s": "d == 4",
      "z": "d == 4",
      "w": "d == 4",
      "V": "middle offset from start is 2 or 6; let e=(end-middle+8)%8. e in {3,4,5} allowed; for e in {2,6}, allowed only if end == opposite(start); other cases forbidden"
    }
  },
  "geometry": {
